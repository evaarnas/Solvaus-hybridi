{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solvaus-hybridi",
  "version": "0.2.2",
  "identifier": "com.gmail.solvaus.hybridi",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": {
      "script": "python3 tools/build-wasm.py",
      "cwd": "..",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "python3 tools/build-wasm.py",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Solvaus-hybridi — N×N Solver Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "gullicube-bundle/": "gullicube-runtime/"
    },
    "category": "Education",
    "shortDescription": "N×N cube solver studio",
        "longDescription": "Build random or custom scrambles, solve with RCube or Gullicube on desktop or Rust/WASM in the browser, replay the solution (independently checked up to 21×21), and watch the moves animate in 3D."
  }
}
